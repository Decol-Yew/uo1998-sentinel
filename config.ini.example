; ============================================================
;  uo1998-sentinel 設定ファイルの雛形
;  このファイルを "config.ini" にコピーして実際の値を記入してください。
;  config.ini は .gitignore 済みなので GitHub には上がりません。
;
;  ※ 翻訳ツール(uo1998-translator)と同じ [capture]/[filter] を使います。
;    翻訳ツールの config.ini があるフォルダで実行すれば、そのまま共有できます。
; ============================================================

[capture]
; 受信方式: Npcap + Scapy によるパッシブ・キャプチャ。
; ゲームサーバ→クライアントの通信を「観測するだけ」で、経路に割り込まず、改変も送信も
; しません(コネロスの心配なし)。
;   要: Npcap 導入( https://npcap.com / WinPcap互換モード )＋管理者権限(run.bat が自動昇格)
;
; キャプチャするネットワークインターフェース名。空欄なら既定のNICを自動選択。
;   インターネットに繋がっている回線(例: 無線なら "Wi-Fi"、有線なら "イーサネット")。
;   名前が分からなければまず空欄で試し、取れなければ下記で一覧を確認:
;     .venv\Scripts\python.exe -c "from scapy.arch.windows import get_windows_if_list as f; [print(repr(i['name'])) for i in f()]"
iface =
; ゲームサーバのTCPポート (UO:1998 は 2593)
game_port = 2593
; デバッグ: yes にすると受信ログを sentinel 側で記録。切り分け用。
debug = no

[filter]
; 自分のキャラ名 (誰のステータスを監視するか判別するために使用)。カンマ区切りで複数可。
;   空でも、本人の拡張ステータス(mana を含む 0x11)から自動判定を試みます。
self_names = YourCharName

; --- 最大所持重量(stones)の決め方 ---
; UO:1998(0x11 type=1)はサーバーが最大重量を送らないので、こちらで算出します。
; このシャードの上限は「ベースSTR」で決まり、ブレス魔法やPotの一時STRでは増えません。
; 実測較正式: 最大重量 = STR*4 + 30 (STR59→266 / STR60→270 / STR93→402)。
;   max_weight>0 を設定 → その固定値を使う(ゲーム内で実測した上限が最も確実・推奨)
;   base_str>0 を設定   → STR*4+30 で算出(無バフ時のベースSTRを入れる)
;   どちらも 0(既定)   → 受信STR(現在値)から STR*4+30 で算出(バフ中は実際と差が出る)
max_weight = 0
base_str = 0
